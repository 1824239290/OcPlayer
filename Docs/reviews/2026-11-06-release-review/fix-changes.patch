+            return try MetadataCache.open(at: root)
+        })
+        coordinator.setActiveServer(StubMediaServer())
+        coordinator.setup(directory: directory)
+        await fulfillment(of: [opened], timeout: 3)
+        let a = Task { await coordinator.currentRepository() }
+        let b = Task { await coordinator.currentRepository() }
+        await gate.release()
+        let repoA = await a.value
+        let repoB = await b.value
+        XCTAssertNotNil(repoA)
+        XCTAssertTrue(repoA === repoB)
+    }
+
+    func testFinalSnapshotSurvivesShutdownButCannotRewindAfterReturningToTenant() async throws {
+        let coordinator = try await makeReadyCoordinator()
+        let a = StubMediaServer(profileID: "A:user")
+        let b = StubMediaServer(profileID: "B:user")
+        coordinator.setActiveServer(a)
+        let created = await coordinator.currentRepository()
+        let repo = try XCTUnwrap(created)
+        let store = try XCTUnwrap(coordinator.activeStore)
+        let item = MediaItem(id: "same", name: "A", kind: .movie)
+        let base = Date()
+        try await store.saveItems([item], tenant: TenantID(profile: a.profile), now: base.addingTimeInterval(-1))
+        let context = try XCTUnwrap(coordinator.capturePlaybackContext())
+        let final = PlaybackProgressSnapshot(item: item, positionSeconds: 60, durationSeconds: 600, capturedAt: base)
+        coordinator.setActiveServer(b)
+        await repo.shutdown()
+        await context.recordFinal(final)
+        let saved = try await store.item(item.id, tenant: TenantID(profile: a.profile))
+        XCTAssertEqual(saved?.item.playState?.positionSeconds, 60)
+        let staleState = MediaItem.PlayState(played: true, percentage: 1, positionSeconds: 600)
+        await repo.applyPlayState(staleState, forItemID: item.id, persistToStore: true)
+        let unchanged = try await store.item(item.id, tenant: TenantID(profile: a.profile))
+        XCTAssertEqual(unchanged?.item.playState?.positionSeconds, 60, "Shutdown still blocks ordinary writes")
+        coordinator.setActiveServer(a)
+        try await store.updatePlayState(staleState, forItemID: item.id, tenant: TenantID(profile: a.profile), now: base.addingTimeInterval(0.1))
+        await context.recordFinal(final)
+        let newest = try await store.item(item.id, tenant: TenantID(profile: a.profile))
+        XCTAssertEqual(newest?.item.playState, staleState)
+    }
