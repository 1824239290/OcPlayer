<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 自建服务(Jellyfin / MoviePilot)常见局域网 http 部署,公网域名也可能 http。
	     用户在连接表单显式选择 HTTP / HTTPS;选 HTTP 时应能真正连上,故全局放行明文。
	     已知取舍:这放弃了对明文流量的 ATS 默认保护;本地敏感数据尽可能走 https。
	     注意:不要同时设置 NSAllowsLocalNetworking——按 Apple 规则它存在时
	     NSAllowsArbitraryLoads 会被忽略(macOS 10.12+),公网 http 又被拦回。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- iOS 后台播放：内核只推 AudioQueue，不会自己申请后台能力；不声明这一项，
	     进程进后台几百毫秒就被挂起，音频出口与 VideoToolbox 解码会话一起被拆掉，
	     回前台第一包数据喂进 avcodec_send_packet 就是 AVERROR_UNKNOWN（-1313558101），
	     播放器被钉在错误态、只能手动点重试。声明 audio 后进程继续活着，配合宿主侧的
	     .playback 音频会话（ErikaKit/ErikaAudioSession.swift）锁屏 / 切后台继续出声。
	     macOS 忽略这一项（该 key 只在 iOS 系生效）。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Bangumi OAuth：client_id / client_secret 只在 OcPlay 网关，客户端不持有；
	     授权回调 scheme 固定为 ocplayer（见下方 CFBundleURLTypes），
	     网关换 token 后 App 处理 ocplayer://oauth/callback 回调。 -->
	<!-- 更新检查的 GitHub 仓库：仓库挪窝只改这里，AppUpdateChecker 从 Bundle 读取。 -->
	<key>GitHubRepoOwner</key>
	<string>1824239290</string>
	<key>GitHubRepoName</key>
	<string>OcPlayer</string>
	<!-- 构建时注入的 Git 提交哈希，用于版本号关于页展示与启动日志排查 -->
	<key>GitCommit</key>
	<string>$(GIT_COMMIT_HASH)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.jumusu.OcPlayer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ocplayer</string>
			</array>
		</dict>
	</array>
	<!-- 声明支持的本地化：App 内文案为中文硬编码，这里登记 zh-Hans 让
	     AppKit/SwiftUI 的标准菜单（文件/编辑/…）与系统面板跟随系统语言（中文）
	     渲染；配套的 App/Shared/zh-Hans.lproj/Localizable.strings 是声明载体。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
</dict>
</plist>
