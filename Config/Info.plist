<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 自建服务(Jellyfin / MoviePilot)常见局域网 http 部署。
	     用户在连接表单显式选择 HTTP / HTTPS;选 HTTP 时应能真正连上(包括公网域名/http),故开 NSAllowsArbitraryLoads 一切允许明文。
	     自用应谨慎行事:放弃了 ATS 对明文的默认保护;本地敏感数据尽可能走 https。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Bangumi OAuth：凭证从 Secrets.xcconfig 注入（BANGUMI_APP_ID / BANGUMI_APP_SECRET）。
	     回调 scheme 固定为 ocplayer，App 处理 bangumi OAuth 回调。 -->
	<key>BANGUMI_APP_ID</key>
	<string>$(BANGUMI_APP_ID)</string>
	<key>BANGUMI_APP_SECRET</key>
	<string>$(BANGUMI_APP_SECRET)</string>
	<key>BANGUMI_OAUTH_CALLBACK</key>
	<string>ocplayer://oauth/callback</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.jumusu.OcPlayer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ocplayer</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
