+    #[test]
+    fn paused_external_subtitle_import_and_reselection_keep_video_and_clock_frozen() {
+        let path = std::env::temp_dir().join(format!(
+            "erika-paused-external-subtitle-{}.srt",
+            std::process::id()
+        ));
+        fs::write(&path, "1\n00:00:00,000 --> 00:00:08,000\nPaused subtitle\n").unwrap();
+        let mut engine = playback_fixture_engine();
+        let position = Duration::from_secs(2);
+        engine.clock.reset(position, false, Instant::now());
+        let demux_generation = engine.session.demuxer.generation;
+        let (track, _) = engine
+            .add_external_subtitle(SubtitleTrackConfig::external(
+                1_000_009,
+                path.to_string_lossy(),
+            ))
+            .unwrap();
+        let frame = engine
+            .tick_subtitle()
+            .unwrap()
+            .expect("imported subtitle while paused");
+        assert_eq!(frame.frame.text[0].display_text(), "Paused subtitle");
+        assert_eq!(frame.media_time, position);
+        engine.select_subtitle_track(None).unwrap();
+        assert!(engine.tick_subtitle().unwrap().is_none());
+        engine.select_subtitle_track(Some(track.id)).unwrap();
+        let restored = engine
+            .tick_subtitle()
+            .unwrap()
+            .expect("reselected subtitle while paused");
+        assert_eq!(restored.frame.text[0].display_text(), "Paused subtitle");
+        assert_eq!(restored.media_time, position);
+        assert_eq!(engine.state(), PlaybackRunState::Paused);
+        assert_eq!(engine.media_time(), position);
+        assert_eq!(engine.session.demuxer.generation, demux_generation);
+        assert!(!engine.paused_seek_frame_pending);
+        assert!(engine.tick().unwrap().is_none());
+        drop(engine);
+        let _ = fs::remove_file(path);
+    }
