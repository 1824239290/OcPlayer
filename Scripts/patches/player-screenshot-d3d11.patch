+    fn capture_current_frame(
+        &mut self,
+        context: RenderFrameContext<'_>,
+        width: u32,
+        height: u32,
+    ) -> Result<Option<RendererFrameCapture>> {
+        if width == 0 || height == 0 {
+            return Err(PlayerError::Renderer(
+                "d3d11: capture size must be non-zero".to_string(),
+            ));
+        }
+        let row_bytes = (width as usize).checked_mul(4).ok_or_else(|| {
+            PlayerError::Renderer("d3d11: capture row size overflowed".to_string())
+        })?;
+        let byte_count = row_bytes.checked_mul(height as usize).ok_or_else(|| {
+            PlayerError::Renderer("d3d11: capture buffer size overflowed".to_string())
+        })?;
+        if self.current_video.is_none() {
+            return Ok(None);
+        }
+        self.ensure_default_device()?;
+        // A PNG has its own SDR output contract, independent of the HDR monitor
+        // and swapchain. Rebuild both video and subtitle uniforms for this target.
+        let target_color = TargetColorState::sdr(ColorPrimaries::Bt709);
+        let overlays = self.prepare_overlay_draws(context.overlay, target_color)?;
+        let video = self.current_video.as_ref().expect("current frame checked");
+        let constants = constants_for_frame(video.source_color, video.texture_format, target_color)
+            .packed_alpha_right(self.video_alpha_mode.has_alpha());
+        let state = self.state.as_ref().expect("device ensured");
+        let desc = D3D11_TEXTURE2D_DESC {
+            Width: width,
+            Height: height,
+            MipLevels: 1,
+            ArraySize: 1,
+            Format: DXGI_FORMAT_R8G8B8A8_UNORM,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Usage: D3D11_USAGE_DEFAULT,
+            BindFlags: D3D11_BIND_RENDER_TARGET.0 as u32,
+            ..Default::default()
+        };
+        let mut texture = None;
+        let mut render_target = None;
+        unsafe {
+            state
+                .device
+                .CreateTexture2D(&desc, None, Some(&mut texture))
+                .map_err(|error| d3d_error("CreateTexture2D(capture)", error))?;
+            state
+                .device
+                .CreateRenderTargetView(texture.as_ref().unwrap(), None, Some(&mut render_target))
+                .map_err(|error| d3d_error("CreateRenderTargetView(capture)", error))?;
+        }
+        let texture = texture.expect("capture texture created");
+        let render_target = render_target.expect("capture render target created");
+        unsafe {
+            state
+                .context
+                .ClearRenderTargetView(&render_target, &[0.0, 0.0, 0.0, 1.0]);
+        }
+        let video_rect = aspect_fit_rect(
+            self.video_alpha_mode.logical_width(video.width),
+            video.height,
+            width,
+            height,
+        );
+        state.draw_video(video, constants, None, &render_target, video_rect)?;
+        // The presenter rebuilt the subtitle overlay at capture resolution.
+        // Its viewport is the entire image, including any aspect-fit bars.
+        state.draw_overlays(
+            &overlays,
+            &render_target,
+            D3d11DrawRect {
+                x: 0.0,
+                y: 0.0,
+                width: width as f32,
+                height: height as f32,
+            },
+        )?;
+        // Intentionally do not composite context.danmaku or present the swapchain.
+        unsafe {
+            state.context.OMSetRenderTargets(None, None);
+        }
+        let mut staging = None;
+        let staging_desc = D3D11_TEXTURE2D_DESC {
+            Usage: D3D11_USAGE_STAGING,
+            BindFlags: 0,
+            CPUAccessFlags: D3D11_CPU_ACCESS_READ.0 as u32,
+            ..desc
+        };
+        unsafe {
+            state
+                .device
+                .CreateTexture2D(&staging_desc, None, Some(&mut staging))
+                .map_err(|error| d3d_error("CreateTexture2D(capture readback)", error))?;
+        }
+        let staging = staging.expect("capture staging texture created");
+        let mut rgba = vec![0_u8; byte_count];
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe {
+            state.context.CopyResource(&staging, &texture);
+            state
+                .context
+                .Map(&staging, 0, D3D11_MAP_READ, 0, Some(&mut mapped))
+                .map_err(|error| d3d_error("Map(capture readback)", error))?;
+        }
+        // Mapped textures have driver-aligned rows; copy only visible RGBA bytes.
+        let valid_mapping = !mapped.pData.is_null() && mapped.RowPitch as usize >= row_bytes;
+        if valid_mapping {
+            for (row, destination) in rgba.chunks_exact_mut(row_bytes).enumerate() {
+                unsafe {
+                    ptr::copy_nonoverlapping(
+                        (mapped.pData as *const u8).add(row * mapped.RowPitch as usize),
+                        destination.as_mut_ptr(),
+                        row_bytes,
+                    );
+                }
+            }
+        }
+        unsafe {
+            state.context.Unmap(&staging, 0);
+        }
+        if !valid_mapping {
+            return Err(PlayerError::Renderer(
+                "d3d11: invalid capture readback row pitch".to_string(),
+            ));
+        }
+        Ok(Some(RendererFrameCapture {
+            width,
+            height,
+            rgba,
+        }))
+    }
