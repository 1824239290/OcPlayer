+                frame: VideoFramePayload::from_decoded(frame).unwrap(),
+                decode_backend: decoder.backend(),
+                pts: None,
+                media_time: Duration::ZERO,
+                late_by: None,
+                generation: 1,
+                scene_avg_nits: None,
+            })
+            .unwrap();
+        // Model retained HDR playback without needing an on-screen window. The
+        // capture must neither require nor replace these swapchain resources.
+        renderer
+            .upload_planar_frame(
+                PlanarFrame {
+                    format: PlanarPixelFormat::P010,
+                    width: 16,
+                    height: 16,
+                    luma: (940_u16 << 6).to_le_bytes().repeat(16 * 16),
+                    chroma: (512_u16 << 6).to_le_bytes().repeat(16 * 16 / 2),
+                },
+                SourceColorState::new(ColorPrimaries::Bt2020, TransferFunction::Pq),
+            )
+            .unwrap();
+        let video = renderer.current_video.as_mut().unwrap();
+        video.source_color = SourceColorState::new(ColorPrimaries::Bt2020, TransferFunction::Pq);
+        video.constants = constants_for_frame(
+            video.source_color,
+            video.texture_format,
+            TargetColorState::hdr10(ColorPrimaries::Bt2020),
+        );
+        let playback_constants = video.constants;
+        renderer.surface = Some(AttachedSurface {
+            hwnd: HWND::default(),
+            composition: true,
+            flutter_texture: false,
+            metrics: SurfaceMetrics::new(1920, 1080, 1.0),
+            output_mode: D3d11OutputMode::Hdr10,
+            swapchain: None,
+            output_texture: None,
+            published_texture: None,
+            render_target: None,
+            linear_render_target: None,
+            linear_shader_resource: None,
+        });
+        let overlay = OverlayFrame {
+            pts: Duration::ZERO,
+            viewport: crate::overlay::OverlayViewport::new(65, 49),
+            subtitle_planes: vec![crate::subtitle::SubtitleBitmapPlane::new(
+                0,
+                0,
+                16,
+                8,
+                [255, 0, 0, 255].repeat(16 * 8),
+            )],
+            subtitle_alpha_planes: vec![],
+            subtitle_changed: true,
+        };
+        let capture = renderer
+            .capture_current_frame(
+                RenderFrameContext::new(Duration::ZERO, 1)
+                    .overlay(Some(&overlay))
+                    .output_size(65, 49),
+                65,
+                49,
+            )
+            .unwrap()
+            .expect("retained D3D11 frame captured");
+        assert_eq!(
+            (capture.width, capture.height, capture.rgba.len()),
+            (65, 49, 65 * 49 * 4)
+        );
+        // Red (not BGRA), at full SDR brightness, including rows with driver padding.
+        for y in 1..7 {
+            let offset = (y * 65 + 1) * 4;
+            assert_eq!(&capture.rgba[offset..offset + 4], &[255, 0, 0, 255]);
+        }
+        assert!(capture.rgba.chunks_exact(4).all(|pixel| pixel[3] == 255));
+        let center = (24 * 65 + 32) * 4;
+        assert!(
+            capture.rgba[center..center + 3]
+                .iter()
+                .all(|channel| *channel > 100),
+            "HDR video stays bright while the gamut LUT is pending: {:?}",
+            &capture.rgba[center..center + 4]
+        );
+        // Exercise the completed LUT as well as the first capture's fallback.
+        let deadline = std::time::Instant::now() + Duration::from_secs(30);
+        while renderer.gamut_lut.is_none() {
+            assert!(
+                std::time::Instant::now() < deadline,
+                "capture LUT did not settle"
+            );
+            std::thread::sleep(Duration::from_millis(20));
+            let with_lut = renderer
+                .capture_current_frame(
+                    RenderFrameContext::new(Duration::ZERO, 1)
+                        .overlay(Some(&overlay))
+                        .output_size(65, 49),
+                    65,
+                    49,
+                )
+                .unwrap()
+                .unwrap();
+            assert!(
+                with_lut.rgba[center..center + 3]
+                    .iter()
+                    .all(|channel| *channel > 100),
+                "HDR video stays bright with the bound gamut LUT: {:?}",
+                &with_lut.rgba[center..center + 4]
+            );
+        }
+        assert_eq!(
+            renderer.current_video.as_ref().unwrap().constants,
+            playback_constants
+        );
+        let surface = renderer.surface.as_ref().unwrap();
+        assert_eq!(surface.output_mode, D3d11OutputMode::Hdr10);
+        assert_eq!(surface.metrics.physical_size(), (1920, 1080));
+        assert!(surface.swapchain.is_none());
+        assert_eq!(renderer.stats.rendered_frames, 0);
+        assert_eq!(renderer.stats.danmaku_passes, 0);
+    }
+
+    #[test]
+    fn d3d11_capture_rejects_empty_size_and_reports_missing_frame() {
+        let mut renderer = D3d11Renderer::new().unwrap();
+        assert!(
+            renderer
+                .capture_current_frame(RenderFrameContext::new(Duration::ZERO, 0), 0, 5)
+                .is_err()
+        );
+        assert!(
+            renderer
+                .capture_current_frame(RenderFrameContext::new(Duration::ZERO, 0), 5, 0)
+                .is_err()
+        );
+        assert!(
+            renderer
+                .capture_current_frame(RenderFrameContext::new(Duration::ZERO, 0), 5, 5)
+                .unwrap()
+                .is_none()
+        );
+    }
