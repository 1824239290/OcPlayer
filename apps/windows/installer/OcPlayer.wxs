<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="OcPlayer" Manufacturer="OcPlayer" Version="$(Version)"
           UpgradeCode="1EDBADE9-AD55-442B-A1DB-752A2A40B549" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已安装更新版本的 OcPlayer。" />
    <Icon Id="OcPlayerIcon" SourceFile="$(InstallerDirectory)\..\src\OcPlayer.Windows\Assets\Branding\OcPlayer.ico" />
    <Property Id="ARPPRODUCTICON" Value="OcPlayerIcon" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWS_BUILD &gt;= 17763)" Message="OcPlayer 需要 Windows 10 1809 或更高版本的 64 位 Windows。" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\OcPlayer\Windows\Installer"
                      Name="InstallLocation" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" Before="CostInitialize"
                 Sequence="both" Condition="NOT INSTALLFOLDER AND PREVIOUSINSTALLFOLDER" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OcPlayer">
          <Component Id="ProtocolRegistration" Guid="9AF3D6AE-0DB5-4461-B31C-3285BE17BCC5">
            <RegistryKey Root="HKCU" Key="Software\Classes\ocplayer">
              <RegistryValue Type="string" Value="URL:OcPlayer OAuth" />
              <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
              <RegistryKey Key="shell\open\command">
                <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]OcPlayer.Windows.exe&quot; --bangumi-oauth-callback &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OcPlayerMenu" Name="OcPlayer">
        <Component Id="StartMenuShortcut" Guid="B67B042C-0D2C-40F1-99B0-E391B3D44853">
          <Shortcut Id="OcPlayerShortcut" Name="OcPlayer" Target="[INSTALLFOLDER]OcPlayer.Windows.exe" WorkingDirectory="INSTALLFOLDER" Icon="OcPlayerIcon" IconIndex="0" />
          <RemoveFolder Id="RemoveOcPlayerMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\OcPlayer\Windows\Installer" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\OcPlayer\Windows\Installer" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Complete" Title="OcPlayer" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ProtocolRegistration" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <WixVariable Id="WixUILicenseRtf" Value="$(InstallerDirectory)\notice.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(InstallerDirectory)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(InstallerDirectory)\dialog.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDirectory)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
