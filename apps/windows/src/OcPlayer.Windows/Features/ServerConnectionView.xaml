<UserControl
    x:Class="OcPlayer.Windows.Features.ServerConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Grid x:Name="Surface">
        <ScrollViewer x:Name="Viewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid x:Name="Layout" MaxWidth="1080" Padding="48,72,48,36" ColumnSpacing="72"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IntroductionColumn" Width="*" />
                    <ColumnDefinition x:Name="FormColumn" Width="440" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="Introduction" Spacing="24" VerticalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#FFECA66B">
                            <FontIcon Glyph="&#xE768;" FontSize="19" Foreground="#FF332216" />
                        </Border>
                        <TextBlock Text="OcPlayer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HeroTitle" Text="好故事，&#x0a;即刻开场。" FontSize="48" FontWeight="Bold"
                               LineHeight="62" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="你的私人影院，从这里开始。" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Width="48" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            HorizontalAlignment="Left" Margin="0,2,0,2" />
                    <StackPanel x:Name="Benefits" Spacing="22">
                        <StackPanel Spacing="5">
                            <TextBlock Text="连接私人媒体库" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="浏览 Jellyfin 或 Emby 中的电影与剧集。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="接着上次继续看" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="同步观看进度，从上次停下的地方继续。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="直接播放本地视频" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="无需登录，打开本地文件即可播放。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="FormCard" Grid.Column="1" CornerRadius="20" Padding="24"
                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ConnectionStep" Text="连接服务器" FontSize="12" FontWeight="SemiBold" />
                                <FontIcon Glyph="&#xE76C;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="AccountStep" Text="登录账号" FontSize="12" Opacity="0.55" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="FormTitle" Text="连接你的媒体库" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="FormDescription" Text="输入 Jellyfin 或 Emby 服务器地址，开始浏览与播放。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="AddressFields" Spacing="12">
                            <StackPanel x:Name="SavedSection" Spacing="9" Visibility="Collapsed">
                                <TextBlock Text="已保存的服务器" FontSize="13" FontWeight="SemiBold" />
                                <ScrollViewer MaxHeight="174" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SavedServers" Spacing="8" />
                                </ScrollViewer>
                            </StackPanel>
                            <TextBox x:Name="AddressInput" Header="服务器地址" PlaceholderText="例如 192.168.1.10:8096"
                                     MinHeight="44" TextChanged="Address_Changed" KeyDown="Address_KeyDown" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ToggleButton x:Name="HttpButton" Content="HTTP" IsChecked="True" Click="Http_Click" MinWidth="72" />
                                <ToggleButton x:Name="HttpsButton" Content="HTTPS" Click="Https_Click" MinWidth="72" />
                            </StackPanel>
                            <TextBlock Text="支持 IP、域名、端口和反向代理路径；完整链接会自动识别协议。"
                                       FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="AccountFields" Spacing="12" Visibility="Collapsed">
                            <Border Padding="12" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ServerName" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ServerAddress" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <ComboBox x:Name="ServerKind" Header="服务器类型" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Jellyfin" /><ComboBoxItem Content="Emby" />
                            </ComboBox>
                            <TextBox x:Name="UsernameInput" Header="用户名" PlaceholderText="服务器上的用户名" KeyDown="Account_KeyDown" />
                            <PasswordBox x:Name="PasswordInput" Header="密码" KeyDown="Account_KeyDown" />
                        </StackPanel>
                        <InfoBar x:Name="ErrorNotice" Severity="Error" IsOpen="False" IsClosable="False" Visibility="Collapsed" />
                        <StackPanel x:Name="ProgressSection" Spacing="7" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock x:Name="ProgressText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="PrimaryAction" Content="连接服务器" Click="Primary_Click" IsEnabled="False"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ChangeAddress" Content="返回修改服务器地址" Click="ChangeAddress_Click"
                                Visibility="Collapsed" HorizontalAlignment="Center" />
                        <Expander x:Name="QuickConnect" Header="使用 Quick Connect 配对" Visibility="Collapsed"
                                  HorizontalAlignment="Stretch" Collapsed="QuickConnect_Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="在另一台已登录的 Jellyfin 设备上输入配对码。" FontSize="12" TextWrapping="Wrap" />
                                <Button x:Name="QuickStart" Content="获取配对码" Click="QuickStart_Click" />
                                <TextBox x:Name="QuickCode" Header="配对码" IsReadOnly="True" Visibility="Collapsed" />
                                <Button x:Name="CopyCode" Content="复制配对码" Click="CopyCode_Click" Visibility="Collapsed" />
                                <TextBlock x:Name="QuickStatus" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="LocalPlayer" Click="LocalPlayer_Click" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0,6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="直接使用本地播放器" FontSize="13" />
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12" />
                            </Grid>
                        </Button>
                        <TextBlock Text="无需登录，稍后可在设置中连接媒体库。" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
