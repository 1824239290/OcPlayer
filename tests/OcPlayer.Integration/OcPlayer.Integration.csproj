  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OcPlayer.CoreAdapter\OcPlayer.CoreAdapter.csproj" />
    <Compile Include="..\..\src\OcPlayer.Windows\Services\MediaServer.cs" Link="MediaServer.cs" />
