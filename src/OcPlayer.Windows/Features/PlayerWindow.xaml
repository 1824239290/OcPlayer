<Window x:Class="OcPlayer.Windows.PlayerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="PlayerRoot" RequestedTheme="Dark" Background="Black" PointerMoved="Player_PointerMoved">
  <Grid.Resources>
   <Style x:Key="HudButton" TargetType="Button">
    <Setter Property="Background" Value="#80303030"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="24"/>
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/>
   </Style>
  </Grid.Resources>
  <Image x:Name="Backdrop" Stretch="UniformToFill"/>
  <SwapChainPanel x:Name="VideoPanel" Visibility="Collapsed"/>
  <Grid x:Name="PlayerTitleBar" Height="48" VerticalAlignment="Top" Background="Transparent" Margin="0,0,150,0"/>
  <Grid x:Name="Hud">
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#80000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <StackPanel x:Name="TopActions" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,16,0,0" Spacing="8">
    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Close_Click" AutomationProperties.Name="关闭播放器"/>
    <Button Content="&#xE740;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Fullscreen_Click" AutomationProperties.Name="全屏"/>
   </StackPanel>
   <Border x:Name="VolumeControls" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80303030" CornerRadius="24" Padding="14,0,6,0" Margin="0,16,150,0">
    <StackPanel Orientation="Horizontal" Spacing="8"><Slider x:Name="Volume" Foreground="White" Width="100" Minimum="0" Maximum="100" Value="40" AutomationProperties.Name="音量"/>
     <Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Mute_Click" AutomationProperties.Name="静音"/></StackPanel>
   </Border>
   <StackPanel Orientation="Horizontal" Spacing="36" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button Content="↶ 10" Width="52" Height="52" FontSize="15" Background="#80303030" BorderThickness="0" CornerRadius="24" Click="Back_Click" AutomationProperties.Name="后退 10 秒"/>
    <Button x:Name="PlayButton" Content="&#xE769;" FontFamily="Segoe Fluent Icons" Width="60" Height="60" FontSize="26" Background="#80303030" BorderThickness="0" CornerRadius="30" Click="Play_Click" AutomationProperties.Name="播放或暂停"/>
    <Button Content="10 ↷" Width="52" Height="52" FontSize="15" Background="#80303030" BorderThickness="0" CornerRadius="24" Click="Forward_Click" AutomationProperties.Name="前进 10 秒"/>
   </StackPanel>
   <TextBlock x:Name="SubtitlePreview" Visibility="Collapsed" Text="字幕预览" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,150"/>
   <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,20" Spacing="8">
    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="EpisodeTitle" FontSize="11" Foreground="#D9FFFFFF"/><TextBlock x:Name="MediaTitle" FontSize="18" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
      <Button Content="&#xE8A1;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Danmaku_Click" AutomationProperties.Name="弹幕"/>
      <Button Content="&#xE7F0;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Subtitles_Click" AutomationProperties.Name="字幕"/>
      <Button Content="&#xE767;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Audio_Click" AutomationProperties.Name="音轨"/>
      <Button Content="&#xE8A5;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="Chapters_Click" AutomationProperties.Name="章节"/>
      <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons" Style="{StaticResource HudButton}" Click="More_Click" AutomationProperties.Name="更多"/>
     </StackPanel>
    </Grid>
    <Slider x:Name="Timeline" RequestedTheme="Dark" Minimum="0" Maximum="1440" Foreground="White" ValueChanged="Timeline_ValueChanged" AutomationProperties.Name="播放进度"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionLabel" FontSize="11" Foreground="#DDFFFFFF"/><TextBlock x:Name="DurationLabel" FontSize="11" Grid.Column="1" Foreground="#DDFFFFFF"/></Grid>
   </StackPanel>
  </Grid>
  <InfoBar x:Name="PlaybackError" IsOpen="False" Severity="Error" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,64,24,0" MaxWidth="850"/>
 </Grid>
</Window>
