<Window
    x:Class="OcPlayer.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OcPlayer.Windows.Controls">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#757575">
        <Grid.Resources>
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,6" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
            <Style x:Key="RoundChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="#45505050" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AmbientBackdropView x:Name="Ambience" Grid.RowSpan="2" Visibility="Collapsed" />
        <!-- The viewport fills the window; the title bar floats above scrolling content. -->
        <Grid x:Name="PageHost" Grid.RowSpan="2" />
        <Border x:Name="HeaderShade" Grid.RowSpan="2" Height="112" VerticalAlignment="Top"
                Background="{ThemeResource OcHeaderScrimBrush}" IsHitTestVisible="False" />
        <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,148,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="NavGroup" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <NavigationView x:Name="MainNavigation" Width="120" MinWidth="0" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                                    IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                                    SelectionFollowsFocus="Enabled" HorizontalAlignment="Left" Background="Transparent"
                                    SelectionChanged="MainNavigation_SelectionChanged" AutomationProperties.Name="主导航">
                        <NavigationView.Resources>
                            <!-- The default top pane reserves 48 DIP for custom content even when empty. -->
                            <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
                            <Thickness x:Key="TopNavigationViewTopNavGridMargin">0</Thickness>
                            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                            <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="Transparent" />
                            <StaticResource x:Key="TopNavigationViewItemForeground" ResourceKey="TextFillColorSecondaryBrush" />
                            <StaticResource x:Key="TopNavigationViewItemForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                        </NavigationView.Resources>
                        <NavigationView.MenuItems>
                            <NavigationViewItem x:Name="HomeNavigationItem" Tag="home" Width="40" ToolTipService.ToolTip="首页" AutomationProperties.Name="首页">
                                <NavigationViewItem.Icon>
                                    <!-- Keep the native 16 DIP icon slot and its indicator layout;
                                         render the circular avatar at the established 18 DIP size. -->
                                    <ImageIcon x:Name="Avatar" Width="16" Height="16" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <ImageIcon.RenderTransform><ScaleTransform ScaleX="1.125" ScaleY="1.125" /></ImageIcon.RenderTransform>
                                    </ImageIcon>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="ViewingNavigationItem" Tag="viewing" Width="40" ToolTipService.ToolTip="观影" AutomationProperties.Name="观影">
                                <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings" Width="40" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                    </NavigationView>
            </StackPanel>
            <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Width="46" Height="48" Margin="0" CornerRadius="0" HorizontalAlignment="Left"
                    Visibility="Collapsed" VerticalAlignment="Stretch" ToolTipService.ToolTip="返回上一页" AutomationProperties.Name="返回上一页" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="PageTitle" Text="首页" FontSize="14" FontWeight="SemiBold" TextLineBounds="Tight" VerticalAlignment="Center" />
                <Button x:Name="ServerButton" Click="Server_Click" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="16" HorizontalAlignment="Left" ToolTipService.ToolTip="连接或管理媒体服务器" AutomationProperties.Name="连接或管理媒体服务器">
                    <TextBlock x:Name="AccountLabel" Text="jumusu · Jellyfin 12.1.0" FontSize="11" Opacity="0.75" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                </Button>
                </StackPanel>
                <Button x:Name="SortButton" Content="⇅" Click="Sort_Click" Style="{StaticResource RoundChromeButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="排序与观看状态筛选" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <SplitButton x:Name="OpenFileButton" Click="OpenFileButton_Click" ToolTipService.ToolTip="打开本地文件；箭头展开其他打开方式" AutomationProperties.Name="打开文件">
                    <SplitButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="打开本地文件…" Click="OpenFile_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="打开直连链接…" Click="OpenLink_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Link" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="连接媒体服务器…" Click="Server_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="World" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout></SplitButton.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="16" /><TextBlock Text="打开文件" /></StackPanel>
                </SplitButton>
                <Button x:Name="RefreshButton" VerticalAlignment="Stretch" Click="Refresh_Click" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <AutoSuggestBox x:Name="GlobalSearch" Width="320" PlaceholderText="搜索全部媒体库"
                                QuerySubmitted="GlobalSearch_QuerySubmitted" TextChanged="GlobalSearch_TextChanged" AutomationProperties.Name="搜索媒体库">
                    <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Top" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Informational" Margin="36,6,36,0" />
    </Grid>
</Window>
