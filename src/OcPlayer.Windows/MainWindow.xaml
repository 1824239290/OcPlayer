<Window
    x:Class="OcPlayer.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OcPlayer.Windows.Controls">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#757575">
        <Grid.Resources>
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,6" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
            <Style x:Key="RoundChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="#45505050" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AmbientBackdropView x:Name="Ambience" Grid.RowSpan="2" Visibility="Collapsed" />
        <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,148,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="NavGroup" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <NavigationView x:Name="MainNavigation" Width="120" MinWidth="0" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                                    IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                                    SelectionFollowsFocus="Enabled" HorizontalAlignment="Left" Background="Transparent"
                                    SelectionChanged="MainNavigation_SelectionChanged" AutomationProperties.Name="主导航">
                        <NavigationView.Resources>
                            <!-- The default top pane reserves 48 DIP for custom content even when empty. -->
                            <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
                            <Thickness x:Key="TopNavigationViewTopNavGridMargin">0</Thickness>
                        </NavigationView.Resources>
                        <NavigationView.MenuItems>
                            <NavigationViewItem x:Name="HomeNavigationItem" Tag="home" Width="40" ToolTipService.ToolTip="首页" AutomationProperties.Name="首页">
                                <NavigationViewItem.Icon><ImageIcon x:Name="Avatar" /></NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="ViewingNavigationItem" Tag="viewing" Width="40" ToolTipService.ToolTip="观影" AutomationProperties.Name="观影">
                                <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings" Width="40" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                    </NavigationView>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Button x:Name="BackButton" Content="‹" Click="Back_Click" Style="{StaticResource RoundChromeButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="返回" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="PageTitle" Text="首页" FontSize="14" FontWeight="SemiBold" />
                <Button x:Name="ServerButton" Click="Server_Click" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="16" HorizontalAlignment="Left" ToolTipService.ToolTip="连接或管理媒体服务器" AutomationProperties.Name="连接或管理媒体服务器">
                    <TextBlock x:Name="AccountLabel" Text="jumusu · Jellyfin 12.1.0" FontSize="11" Opacity="0.75" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                </Button>
                </StackPanel>
                <Button x:Name="SortButton" Content="⇅" Click="Sort_Click" Style="{StaticResource RoundChromeButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="排序与观看状态筛选" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource RoundChromeButtonStyle}" ToolTipService.ToolTip="打开媒体" AutomationProperties.Name="打开媒体">
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="打开本地文件…" Click="OpenFile_Click" />
                        <MenuFlyoutItem Text="打开直连链接…" Click="OpenLink_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="连接媒体服务器…" Click="Server_Click" />
                    </MenuFlyout></Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="18" /><FontIcon Glyph="&#xE70D;" FontSize="9" /></StackPanel>
                </Button>
                <Button Click="Refresh_Click" Style="{StaticResource RoundChromeButtonStyle}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="17" />
                </Button>
                <Grid Width="320">
                    <TextBox x:Name="GlobalSearch" PlaceholderText="搜索全部媒体库" Padding="32,6,12,6"
                             CornerRadius="20" KeyDown="GlobalSearch_KeyDown" TextChanged="GlobalSearch_TextChanged" Background="#45505050" BorderThickness="0" />
                    <FontIcon Glyph="&#xE721;" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Informational" Margin="36,6,36,0" />
            <Grid x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
