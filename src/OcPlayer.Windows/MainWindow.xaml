<Window
    x:Class="OcPlayer.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#757575">
        <Grid.Resources>
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,6" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
            <Style x:Key="RoundChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="#45505050" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Image x:Name="Ambience" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="1" IsHitTestVisible="False" />
        <Border x:Name="AmbienceTint" Grid.RowSpan="2" Background="#20535357" IsHitTestVisible="False" />
        <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,148,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="#45505050" CornerRadius="18" VerticalAlignment="Center" Padding="6,3">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="HomeButton" Tag="home" Click="Section_Click" Style="{StaticResource ChromeButtonStyle}" ToolTipService.ToolTip="首页" AutomationProperties.Name="首页">
                        <Border CornerRadius="9" Width="18" Height="18"><Image x:Name="Avatar" Stretch="UniformToFill" /></Border>
                    </Button>
                    <Button x:Name="ViewingButton" Tag="viewing" Click="Section_Click" Style="{StaticResource ChromeButtonStyle}" ToolTipService.ToolTip="观影" AutomationProperties.Name="观影">
                        <FontIcon Glyph="&#xE714;" FontSize="15" />
                    </Button>
                    <Button x:Name="SettingsButton" Tag="settings" Click="Section_Click" Style="{StaticResource ChromeButtonStyle}" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="PageTitle" Text="首页" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="演示账号 · Jellyfin 12.1.0" FontSize="11" Opacity="0.65" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource RoundChromeButtonStyle}" ToolTipService.ToolTip="打开媒体" AutomationProperties.Name="打开媒体">
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="打开本地文件…" Click="OpenFile_Click" />
                        <MenuFlyoutItem Text="打开直连链接…" Click="OpenLink_Click" />
                    </MenuFlyout></Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="18" /><FontIcon Glyph="&#xE70D;" FontSize="9" /></StackPanel>
                </Button>
                <Button Click="Refresh_Click" Style="{StaticResource RoundChromeButtonStyle}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="17" />
                </Button>
                <Grid Width="320">
                    <TextBox x:Name="GlobalSearch" PlaceholderText="搜索全部媒体库" Padding="32,6,12,6"
                             CornerRadius="20" KeyDown="GlobalSearch_KeyDown" Background="#45505050" BorderThickness="0" />
                    <FontIcon Glyph="&#xE721;" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational" Margin="36,6,36,0" />
            <Grid x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
