+fn hdr10_requested_for_source(
+    requested: crate::renderer::output::OutputMode,
+    source: SourceColorState,
+) -> bool {
+    matches!(source.transfer, TransferFunction::Pq)
+        && requested.resolve_for_source(source.is_hdr()).is_edr()
+        && requested.headroom() > 1.0
+}
+
+fn display_hdr10_active(description: Option<&DXGI_OUTPUT_DESC1>) -> bool {
+    description.is_some_and(|desc| {
+        desc.AttachedToDesktop.as_bool()
+            && desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020
+    })
+}
+
+fn display_output_description(
+    surface: &AttachedSurface,
+    cached_factory: &mut Option<IDXGIFactory2>,
+) -> Option<DXGI_OUTPUT_DESC1> {
+    // Composition swap chains cannot identify their output themselves. Use
+    // the host HWND for both kinds of swap chain; an unknown monitor stays SDR.
+    if surface.hwnd.0.is_null() {
+        return None;
+    }
+    // GetDesc1 color information becomes stale when the desktop's HDR state
+    // changes. DXGI requires a current factory and an output from that factory.
+    if !cached_factory
+        .as_ref()
+        .is_some_and(|factory| unsafe { factory.IsCurrent().as_bool() })
+    {
+        *cached_factory = unsafe { CreateDXGIFactory1::<IDXGIFactory2>() }.ok();
+    }
+    let factory = cached_factory.as_ref()?;
+    let monitor = unsafe { MonitorFromWindow(surface.hwnd, MONITOR_DEFAULTTONEAREST) };
+    let mut adapter_index = 0;
+    while let Ok(adapter) = unsafe { factory.EnumAdapters(adapter_index) } {
+        let mut output_index = 0;
+        while let Ok(output) = unsafe { adapter.EnumOutputs(output_index) } {
+            if unsafe { output.GetDesc() }
+                .ok()
+                .is_some_and(|desc| desc.Monitor == monitor)
+            {
+                let output6: IDXGIOutput6 = output.cast().ok()?;
+                return unsafe { output6.GetDesc1() }.ok();
+            }
+            output_index += 1;
+        }
+        adapter_index += 1;
+    }
+    None
+}
