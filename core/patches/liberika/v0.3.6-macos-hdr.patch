+/// The PQ drawable is display-referred HDR. Core Animation must receive its
+/// mastering range before nextDrawable, otherwise out-of-display highlights
+/// can be clipped instead of tone mapped. The PQ encoding ceiling is not the
+/// source mastering peak (nor the screen's EDR headroom).
+#[cfg(target_os = "macos")]
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct Hdr10LayerMetadata {
+    min_nits: f32,
+    max_nits: f32,
+}
+
+#[cfg(target_os = "macos")]
+impl Hdr10LayerMetadata {
+    fn for_source(source: SourceColorState) -> Option<Self> {
+        if source.transfer != TransferFunction::Pq {
+            return None;
+        }
+        let mastering = source.hdr_metadata.and_then(|hdr| hdr.mastering_display);
+        let peak = mastering
+            .and_then(|m| m.max_luminance_nits)
+            .filter(|n| n.is_finite() && *n > 0.0)
+            .or_else(|| {
+                source
+                    .hdr_metadata
+                    .and_then(|hdr| hdr.nominal_peak_nits())
+                    .filter(|n| n.is_finite() && *n > 0.0)
+            })
+            .unwrap_or(1000.0)
+            .min(10_000.0);
+        let black = mastering
+            .and_then(|m| m.min_luminance_nits)
+            .filter(|n| n.is_finite() && *n >= 0.0 && *n < peak)
+            .unwrap_or(0.0);
+        Some(Self {
+            min_nits: black,
+            max_nits: peak,
+        })
+    }
+}
