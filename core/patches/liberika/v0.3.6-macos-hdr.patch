+            .hdr_metadata(Some(HdrMetadata::new(
+                Some(MasteringDisplayMetadata {
+                    display_primaries: None,
+                    white_point: None,
+                    min_luminance_nits: Some(0.0001),
+                    max_luminance_nits: Some(peak),
+                }),
+                None,
+            )))
+        };
+        renderer.configure_layer_source_color(&layer, source(1000.0));
+        let first = layer.EDRMetadata().unwrap();
+        assert_eq!(renderer.layer_hdr_metadata.unwrap().max_nits, 1000.0);
+        renderer.configure_layer_source_color(&layer, source(1000.0));
